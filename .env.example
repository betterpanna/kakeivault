# ============================================================
# KakeiVault — Environment Variables
# ============================================================
# Copy this file to .env and fill in all required values.
# NEVER commit .env to git. It is in .gitignore.
#
# Required values (no default): marked with REQUIRED
# Optional values have a commented default.

# ------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------
POSTGRES_DB=kakeivault
POSTGRES_USER=kakeivault
POSTGRES_PASSWORD=REQUIRED_CHANGE_THIS_IN_PRODUCTION

# Full async connection URL (used by FastAPI + Alembic)
DATABASE_URL=postgresql+psycopg://kakeivault:REQUIRED_CHANGE_THIS_IN_PRODUCTION@localhost:5432/kakeivault

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
REDIS_PASSWORD=REQUIRED_CHANGE_THIS_IN_PRODUCTION
REDIS_URL=redis://:REQUIRED_CHANGE_THIS_IN_PRODUCTION@localhost:6379/0

# ------------------------------------------------------------------
# JWT Authentication
# SECURITY: jwt_secret_key must be at least 64 random characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# ------------------------------------------------------------------
JWT_SECRET_KEY=REQUIRED_CHANGE_THIS_IN_PRODUCTION_USE_64_RANDOM_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ------------------------------------------------------------------
# Cookies
# ------------------------------------------------------------------
COOKIE_SECURE=false        # Set to true in production (requires HTTPS)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.kakeivault.app   # Uncomment in production

# ------------------------------------------------------------------
# S3-compatible storage (MinIO for local dev)
# ------------------------------------------------------------------
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=REQUIRED_CHANGE_THIS_IN_PRODUCTION
STORAGE_BUCKET_NAME=kakeivault
STORAGE_REGION=ap-northeast-1
STORAGE_PRESIGN_EXPIRY_SECONDS=900

# MinIO console credentials (local only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REQUIRED_CHANGE_THIS_IN_PRODUCTION

# ------------------------------------------------------------------
# Email (SMTP)
# Use a real SMTP service in production. In dev, use MailHog or similar.
# ------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kakeivault.app
SMTP_FROM_NAME=KakeiVault
SMTP_TLS=false

# ------------------------------------------------------------------
# OCR provider
# Set to "stub" for local dev. Set to "google_vision" for production.
# ------------------------------------------------------------------
OCR_PROVIDER=stub
# GOOGLE_VISION_CREDENTIALS_JSON=/path/to/service-account.json

# ------------------------------------------------------------------
# Frontend URL (for email links)
# ------------------------------------------------------------------
WEB_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Next.js web app
# ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------
# Expo mobile app
# ------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000
