{
  "name": "@kakeivault/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint app components lib --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf .expo"
  },
  "dependencies": {
    "@kakeivault/config": "workspace:*",
    "@kakeivault/contracts": "workspace:*",
    "@kakeivault/domain": "workspace:*",
    "@kakeivault/i18n": "workspace:*",
    "@kakeivault/validation": "workspace:*",
    "@tanstack/react-query": "^5.62.16",
    "expo": "~52.0.18",
    "expo-camera": "~16.0.10",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~17.0.1",
    "expo-image-picker": "~16.0.4",
    "expo-local-authentication": "~14.0.1",
    "expo-router": "~4.0.14",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-reanimated": "~3.16.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "^5.7.3",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.2",
    "@testing-library/react-native": "^13.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ]
  }
}
